  <diagram id="T9IYXOMsiV7O9u4ljYX0" name="API">
    <mxGraphModel dx="1488" dy="831" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tfJFBOHWSLUI1L5tnfZm-1" value="&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;ダッシュボード&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;GET /api/dashboard?month=2026-07&lt;/code&gt; — 残額・消化率・内訳・日毎累計・今日の支出を集約して1本で返す(前に決めた集約エンドポイント)&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;支出&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;GET /api/transactions?month=2026-07&amp;amp;categoryId=&amp;amp;page=&amp;amp;size=&lt;/code&gt; — 一覧(絞込+ページング+月合計)&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;POST /api/transactions&lt;/code&gt; — 登録&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;PUT /api/transactions/{id}&lt;/code&gt; — 更新&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;DELETE /api/transactions/{id}&lt;/code&gt; — 削除&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;カテゴリ&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;GET /api/categories&lt;/code&gt; — 一覧(is_active=TRUEのみ)&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;POST /api/categories&lt;/code&gt; / &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;PUT /api/categories/{id}&lt;/code&gt; / &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;DELETE /api/categories/{id}&lt;/code&gt;(実体は論理削除)&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;予算&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;GET /api/budgets?month=2026-07&lt;/code&gt; — 月全体+カテゴリ別まとめて&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;PUT /api/budgets?month=2026-07&lt;/code&gt; — まとめて更新(後述の論点あり)&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;POST /api/budgets/copy?from=2026-06&amp;amp;to=2026-07&lt;/code&gt; — 先月からコピー&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;定期支出&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;GET /api/recurring-transactions&lt;/code&gt; / &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;POST&lt;/code&gt; / &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;PUT /{id}&lt;/code&gt; / &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;DELETE /{id}&lt;/code&gt;&lt;/li&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;PATCH /api/recurring-transactions/{id}/status&lt;/code&gt; — 有効/無効トグル(トグルだけ軽量に切り出すか、PUTに含めるかは論点)&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal&quot; dir=&quot;auto&quot;&gt;&lt;strong&gt;内部API(バッチ用)&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;ul dir=&quot;auto&quot; class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3&quot;&gt;&#xa;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;Lambda→Spring経由にするなら &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;POST /internal/recurring-transactions/execute&lt;/code&gt; 的なやつ。認証方式(APIキー?IAM?)も含めて工程12の論点&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="560" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="tfJFBOHWSLUI1L5tnfZm-2" value="{&#xa;  &quot;month&quot;: &quot;2026-07&quot;,&#xa;  &quot;budget&quot;: {&quot;totalAmount&quot;: 80000, &quot;isSet&quot;: true},&#xa;  &quot;summary&quot;: {&#xa;    &quot;totalSpent&quot;: 56600,&#xa;    &quot;remaining&quot;: 23400,&#xa;    &quot;usageRate&quot;: 71,&#xa;    &quot;remainingDays&quot;: 12,&#xa;    &quot;dailyBudget&quot;: 1950&#xa;  },&#xa;  &quot;categoryBreakdown&quot;: [&#xa;    {&quot;categoryId&quot;: 1, &quot;name&quot;: &quot;食費&quot;, &quot;color&quot;: &quot;#7F77DD&quot;, &quot;amount&quot;: 21000}&#xa;  ],&#xa;  &quot;dailyCumulative&quot;: [&#xa;    {&quot;date&quot;: &quot;2026-07-01&quot;, &quot;cumulativeAmount&quot;: 3200}&#xa;  ],&#xa;  &quot;today&quot;: {&#xa;    &quot;totalAmount&quot;: 2300,&#xa;    &quot;isOverDailyBudget&quot;: true,&#xa;    &quot;transactions&quot;: [&#xa;      {&quot;id&quot;: 101, &quot;categoryName&quot;: &quot;食費&quot;, &quot;categoryColor&quot;: &quot;#7F77DD&quot;, &quot;memo&quot;: &quot;ランチ&quot;, &quot;amount&quot;: 980}&#xa;    ]&#xa;  }&#xa;}" style="text;whiteSpace=wrap;" vertex="1" parent="1">
